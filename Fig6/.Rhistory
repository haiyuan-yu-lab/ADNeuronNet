specific_genes <- c('APOE', 'FABP3', 'TMX1', 'LIPA', 'RIDA', 'COX20', 'PLCL2', 'CPT2', 'DHRS4',
'CERK', 'MRM1', 'MTX3', 'DGKE', 'SGPL1', 'TOMM34', 'PLCB1', 'STAT5B', 'NECTIN1', 'SLC25A4',
'ANAPC2', 'ANAPC1', 'PLXNA3', 'EVL', 'CDK16', 'NCAM2' )
