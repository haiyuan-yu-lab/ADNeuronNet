GSEA_up <- read.csv("GSEAup3groups.csv",header=T)
colnames(GSEA_up) <- c("name", "genes_in_gsea", "description", "genes_in_data", "k/K", "p-value", "FDR")
GSEA_up$FDR <- as.numeric(GSEA_up$FDR)
GSEA_up$logP <- -log10(GSEA_up$FDR)
