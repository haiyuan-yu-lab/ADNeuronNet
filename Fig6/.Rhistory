data <- read_excel("Fig6_data.xlsx",sheet = "GSEAup3groups")
colnames(GSEA_up) <- c("name", "genes_in_gsea", "description", "genes_in_data", "k/K", "p-value", "FDR")
GSEA_up <- read_excel("Fig6_data.xlsx",sheet = "GSEAup3groups")
colnames(GSEA_up) <- c("name", "genes_in_gsea", "description", "genes_in_data", "k/K", "p-value", "FDR")
GSEA_up$FDR <- as.numeric(GSEA_up$FDR)
GSEA_up$logP <- -log10(GSEA_up$FDR)
GSEA_up$enrich <- paste(GSEA_up$genes_in_data, "/", GSEA_up$genes_in_gsea, sep=" ")
GSEA_up <- GSEA_up[order(GSEA_up$FDR),]
GSEA_up$Name <-  gsub("GO_", "", GSEA_up$name)
GSEA_up$Name <- gsub("*_", " ", GSEA_up$Name)
# for some reason, you need this section twice
GSEA_up$Name <-  factor(GSEA_up$Name, levels=(GSEA_up$Name))
GSEA_up$Name <-  factor(GSEA_up$Name, levels=rev(GSEA_up$Name))
GSEA_up <- head(GSEA_up, 20)
ggplot(data=GSEA_up, aes(x=Name  , y=logP)) +
theme_classic() +
ylab("-Log(FDR)") + xlab(NULL) +
geom_bar(stat="Identity",  width=0.7, fill="red", alpha=0.8) +
geom_text(aes(label=enrich), vjust=0.4,
hjust=0, size=4, color="black",
stat="Identity", y=0.05*max(GSEA_up$logP)) +
coord_flip() +
theme(aspect.ratio = 2, plot.margin = unit(c(1,1,1,2), "cm"), axis.text.y = element_text(size = 10),
axis.text.x = element_text(size = 12), plot.title = element_text(size = 14, face = "bold"))+
ggtitle("Common ANAPC sh vs. Con - Up")
GSEA_dn <- read_excel("Fig6_data.xlsx",sheet = "GSEAdown3groups")
colnames(GSEA_dn) <- c("name", "genes_in_gsea", "description", "genes_in_data", "k/K", "p-value", "FDR")
GSEA_dn$FDR <- as.numeric(GSEA_dn$FDR)
GSEA_dn$logP <- -log10(GSEA_dn$FDR)
# Calculate the gene ratio for dot plot sizing
GSEA_dn$gene_ratio <- GSEA_dn$genes_in_data / GSEA_dn$genes_in_gsea
# Create the 'enrich' column as a string for potential labels if needed, but not directly used for sizing in this dot plot
GSEA_dn$enrich <- paste(GSEA_dn$genes_in_data, "/", GSEA_dn$genes_in_gsea, sep = " ")
GSEA_dn <- GSEA_dn[order(-GSEA_dn$logP), ]
GSEA_dn$name <- factor(GSEA_dn$name, levels = rev(GSEA_dn$name))
# Dot Plot
ggplot(data = GSEA_dn, aes(x = logP, y = name)) + # Swap x and y for horizontal dots
theme_classic() +
xlab("-Log(FDR)") + ylab(NULL) +
geom_point(aes(size = gene_ratio, color = logP), alpha = 0.8) + # Use size for gene_ratio and color for logP
scale_color_gradient(low = "blue", high = "red") + # Customize color gradient
labs(size = "Gene Ratio", color = "-Log(FDR)") + # Legend titles
theme(aspect.ratio = 2,
plot.margin = unit(c(1, 1, 1, 2), "cm"),
axis.text.y = element_text(size = 10),
axis.text.x = element_text(size = 12),
plot.title = element_text(size = 14, face = "bold"),
legend.position = "right") + # Position of legends
ggtitle("Common ANAPC sh vs. Con - Down")
